{
  "realm": "mam",
  "enabled": true,
  "displayName": "MAM",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "loginTheme": "mam",
  "internationalizationEnabled": true,
  "defaultLocale": "tr",
  "supportedLocales": [
    "tr",
    "en"
  ],
  "clients": [
    {
      "clientId": "mam-web",
      "name": "mam-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__CLIENT_SECRET__",
      "redirectUris": [
        "http://__PUBLIC_HOST__:3000/oauth2/callback"
      ],
      "webOrigins": [
        "http://__PUBLIC_HOST__:3000"
      ],
      "baseUrl": "http://__PUBLIC_HOST__:3000",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "metmam-mobile",
      "name": "metmam-mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "com.example.metmam:/oauth2redirect"
      ],
      "webOrigins": [
        "+"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    }
  ],
  "roles": {
    "realm": []
  },
  "groups": [
    { "name": "dokyonet" },
    { "name": "dokkullan" },
    { "name": "fotokullan" },
    { "name": "fotoyonet" },
    { "name": "superadmin" },
    { "name": "altyazı_ocr_operator" },
    { "name": "standart yönetici" }
  ],
  "users": [
    {
      "username": "__MAM_SUPERADMIN_USER__",
      "enabled": true,
      "emailVerified": true,
      "groups": [
        "/superadmin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "__MAM_SUPERADMIN_PASSWORD__",
          "temporary": false
        }
      ]
    },
    {
      "username": "__MAM_ADMIN_USER__",
      "enabled": true,
      "emailVerified": true,
      "groups": [
        "/standart yönetici"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "__MAM_ADMIN_PASSWORD__",
          "temporary": false
        }
      ]
    },
    {
      "username": "__MAM_USER__",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "__MAM_USER_PASSWORD__",
          "temporary": false
        }
      ]
    }
  ]
}
