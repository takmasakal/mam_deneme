# Non-secret deployment values only.
# Passwords and client secrets are generated by deploy/init.sh or deploy/init-rpi.sh
# under deploy/secrets/ and are mounted with Docker Compose secrets.

PUBLIC_HOST=localhost

# Keycloak admin account username only. Password is keycloak_admin_password secret.
KEYCLOAK_ADMIN=admin

# Keycloak database username/name only. Password is keycloak_db_password secret.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak

# OAuth2 Proxy / OIDC client id only. Client secret and cookie secret are Docker secrets.
OAUTH2_PROXY_CLIENT_ID=mam-web
OAUTH2_PROXY_OIDC_ISSUER_URL=http://keycloak:8080/realms/mam
OAUTH2_PROXY_REDIRECT_URL=http://localhost:3000/oauth2/callback

# Seed realm usernames only. Passwords are mam_*_password Docker secrets.
MAM_ADMIN_USER=mamadmin
MAM_USER=mamuser
MAM_TEXT_ADMIN_USER=yazici

# Office editor provider:
# none       = lightweight native workflow, no web Office editor container
# onlyoffice = enable ONLYOFFICE web editor
# libreoffice = offline read-only PDF preview via LibreOffice headless
OFFICE_EDITOR_PROVIDER=onlyoffice

# Set true only when OFFICE_EDITOR_PROVIDER=libreoffice or when you want
# LibreOffice tools installed inside the app image. Default keeps image smaller.
INSTALL_LIBREOFFICE=false
